---
import { Image } from "astro:assets";
import arrowIcon from "../../src/assets/arrow.png";
---

<style>
  .hidden {
    display: none;
  }

  h2 {
    font-size: 2.25rem;
    margin-bottom: 1.75rem;
    text-align: center;
  }

  h3 {
    color: var(--large-text-color);
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .main-container {
    position: relative;
    margin: 2.5rem 0.94rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 4rem;
  }
  .card {
    filter: drop-shadow(0px 2px 5px rgba(20, 37, 61, 0.1));
    width: 100%;
  }
  .card-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-direction: row;
    position: relative;
    border-radius: 0.625rem;
    height: 4.125rem;
    background-color: var(--soft-background-color);
    padding: 0.86rem;
    filter: drop-shadow(0px 7px 10.0992px rgba(1, 2, 36, 0.1));
    cursor: pointer;
  }

  .card-title::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 6px;
    border-radius: 10px 0 0 10px;
    background-color: var(--large-text-color);
    transition: all 0.3s ease;
  }

  .card-title.active::before {
    background-color: var(--primary-color);
  }

  .arrow-icon {
    width: 0.9375rem;
    height: 0.9375rem;
    transition: transform 0.3s ease;
  }

  .arrow-icon-reversed {
    transform: rotate(180deg);
  }

  .card-text {
    margin-top: -0.375rem;
    padding: 1.375rem 1.1875rem;
    background-color: var(--soft-background-color);
    border-radius: 0 0 0.625rem 0.625rem;
  }

  .card-container {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    width: 100%;
    align-items: center;
  }
  .no-bold {
    margin-top: 4.1875rem;
    font-weight: 500;
  }

  .susisiek {
    color: var(--large-text-color);
    font-size: 1.125rem;
    font-weight: 700;
    width: 8.125rem;
    height: 2.8125rem;
    border-radius: 0.3125rem;
    border: 2px solid var(--large-text-color);
    background: var(--background-color);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .susisiek:hover {
    color: var(--background-color);
    background-color: var(--large-text-color);
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .main-container {
      margin-top: 5rem;
    }
    .card-container {
      width: auto;
    }
    .card-title {
      min-width: 45.5rem;
      max-width: 45.5rem;
    }
    .card-text {
      max-width: 45.5rem;
    }
  }

  @media (min-width: 1024px) {
    .main-container {
      margin-top: 9.375rem;
    }
  }
</style>
<div class="main-container">
  <h2>D.U.K</h2>
  <div class="card-container">
    <div class="card">
      <div class="card-title">
        <h3>Kaip užsiregistruoti pradinei konsultacijai?</h3>
        <Image class="arrow-icon" src={arrowIcon} alt="icon" loading="lazy" />
      </div>
      <div class="card-text hidden">
        Užsiregistruoti galite keliais būdais: <br />
        – užpildę registracijos formą, <br /> – parašę per kontaktų formą, <br
        /> – paskambinę telefonu +370 639 96 502, <br /> – arba parašę žinutę per
        Instagram ar Facebook.
      </div>
    </div>
    <div class="card">
      <div class="card-title">
        <h3>Ar paslaugos yra mokamos?</h3>
        <Image class="arrow-icon" src={arrowIcon} alt="icon" loading="lazy" />
      </div>
      <div class="card-text hidden">
        Taip, visos paslaugos yra mokamos. Kainas rasite paslaugų skiltyje. Jei
        kyla klausimų – drąsiai kreipkitės.
      </div>
    </div>
    <div class="card">
      <div class="card-title">
        <h3>Ar galiu kreiptis be gydytojo siuntimo?</h3>
        <Image class="arrow-icon" src={arrowIcon} alt="icon" loading="lazy" />
      </div>
      <div class="card-text hidden">
        Taip, siuntimo nereikia – galite kreiptis tiesiogiai.
      </div>
    </div>
    <div class="card">
      <div class="card-title">
        <h3>Kaip turėčiau pasiruošti pradinei konsultacijai?</h3>
        <Image class="arrow-icon" src={arrowIcon} alt="icon" loading="lazy" />
      </div>
      <div class="card-text hidden">
        Apranga turėtų būti patogi, leidžianti laisvai judėti ir įvertinti Jūsų
        laikyseną. Jei turite – atsineškite turimus medicininius išrašus ar
        tyrimų rezultatus.
      </div>
    </div>
  </div>
  <h2 class="no-bold">Dar vis turite klausimu?</h2>
  <a href="/kontaktai" class="susisiek">Susisiek</a>
</div>

<script>
  const cardButtons = document.querySelectorAll(".card-title");

  cardButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const card = button.closest(".card");
      const text = card.querySelector(".card-text");
      const arrow = card.querySelector(".arrow-icon");

      text.classList.toggle("hidden");
      arrow.classList.toggle("arrow-icon-reversed");
      button.classList.toggle("active");
    });
  });
</script>
