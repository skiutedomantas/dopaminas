---
import { Image } from "astro:assets";
import ig from "/src/assets/ig_black.png";
import fb from "/src/assets/fb_black.png";
import arrow from "/src/assets/arrow_white.png";
import arrow_blue from "/src/assets/blue_arrow.png";
import Autorius from "../../components/Autorius.astro";
import Base from "../../layouts/Base.astro";
export async function getStaticPaths() {
  const API_URL = "http://localhost/wordpress/wp-json/wp/v2/straipsniai";
  const res = await fetch(`${API_URL}?acf_format=standard&per_page=20`);
  const blogs = await res.json();

  return blogs.map((blog) => ({
    params: { slug: blog.slug },
  }));
}

const API_URL = "http://localhost/wordpress/wp-json/wp/v2/straipsniai";
const res = await fetch(`${API_URL}?acf_format=standard&per_page=20`);
const blogs = await res.json();

const { slug } = Astro.params;

const blog = blogs.find((b) => b.slug === slug);
const five = blogs.slice(0, 5);
---

<style is:global>
  html {
    scroll-timeline: --page-scroll block;
  }

  h1 {
    color: var(--large-text-color);
    font-size: 28px;
  }

  h2 {
    margin-top: 4rem;
    font-size: 24px;
  }

  h3 {
    font-size: 20px;
  }

  h2,
  h3 {
    color: var(--large-text-color);
    margin-bottom: 0.6rem;
  }

  .main-container {
    margin-top: 5rem;
    display: flex;
    justify-content: center;
    flex-direction: column;
    padding: 0 5%;
    gap: 5rem;
  }

  .content-text::before,
  .content-text::after {
    content: "";
    display: block;
    width: 10%;
    height: 2px;
    background-color: var(--large-text-color);
    margin: 2rem 0;
  }

  .content-text p {
    margin-bottom: 1rem;
    font-size: 18px;
    line-height: 1.8;
  }
  .content-text img {
    width: 250px;
    margin: 3rem 0;
    margin-left: auto;
    margin-right: auto;
    display: block;
    border-radius: 5px;
  }

  ol,
  ul {
    padding-left: 1.2rem;
    line-height: 2;
  }

  table {
    margin: 3rem 0;
  }

  th {
    background-color: var(--primary-color);
    color: var(--background-color);
    padding: 0.5rem;
  }

  td {
    background-color: var(--soft-background-color);
    padding: 0.5rem;
  }

  .wp-caption {
    display: block;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: 1rem;
    width: fit-content !important;
  }

  .wp-caption-text {
    max-width: fit-content;
    margin-left: auto;
    margin-right: auto;
    text-align: center;
    margin-top: -2rem;
    font-size: 12px !important;
  }

  blockquote {
    background-color: var(--soft-background-color);
    padding: 1.5rem;
    border-radius: 1rem;
    position: relative;
    font-style: italic;
    margin: 2rem 0;
  }

  blockquote::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 6px;
    border-radius: 10px 0 0 10px;
    background-color: var(--primary-color);
  }

  .content-text blockquote p {
    margin-bottom: 0;
  }

  .icon {
    margin-top: 0.4rem;
    width: 2.5rem;
    height: 2.5rem;
  }

  .icon:first-of-type {
    margin-right: 0.7rem;
  }

  .popular-blog {
    font-size: 13px;
    margin: 0.8rem 0;
    border-top: 1px solid #383d431f;
    width: 90%;
    padding-top: 0.8rem;
    transition: all 0.3s ease;
  }

  .popular-blog:last-of-type {
    border-bottom: 1px solid #383d431f;
    padding-bottom: 0.8rem;
  }

  .popular-blog:hover {
    color: var(--primary-color);
  }

  .contacts {
    margin-bottom: 6rem;
  }

  .icon-container {
    margin-top: 1rem;
  }

  .sekite-mane {
    font-weight: 600;
    position: relative;
    padding-left: 1rem;
  }

  .sekite-mane::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 3px;
    border-radius: 10px 0 0 10px;
    background-color: var(--primary-color);
  }

  .literatura {
    font-size: 14px;
    cursor: pointer;
    color: #0a0b0cb0;
  }

  .overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.5);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }

  .overlay-content {
    background-color: var(--soft-background-color);
    padding: 2rem;
    border-radius: 8px;
    max-width: 700px;
    width: 100%;
    max-height: calc(100vh - 10rem);
    overflow-y: auto;
    position: relative;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    margin: auto;
  }

  .overlay-content ol {
    line-height: 1.4;
  }
  .overlay-content li {
    margin-bottom: 1rem;
  }

  .overlay-content li:last-of-type {
    margin-bottom: 0;
  }

  .overlay-content p {
    margin-bottom: 0.5rem;
  }

  .close-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: none;
    border: none;
    font-size: 20px;
    cursor: pointer;
  }

  .close-btn:hover {
    color: var(--primary-color);
  }

  #progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 1em;
    width: 0%;
    background: var(--primary-color);
    z-index: 99999;
    transition: width 0.1s linear;
  }

  .back-to-top {
    position: fixed;
    bottom: 3rem;
    right: 3rem;
    background-color: var(--primary-color);
    padding: 0.8rem;
    border-radius: 20%;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    transition: opacity 0.3s ease;
    cursor: pointer;
  }
  .back-to-top img {
    width: 20px;
    transform: rotate(-90deg);
  }

  .heading-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  .back-arrow img {
    margin-top: 0.5rem;
    width: 24px;
  }
  .clickable-title {
    text-decoration: none;
    color: inherit;
  }
  .clickable-title h1:hover {
    text-decoration: none;
    color: var(--primary-color);
  }

  .didesnis,
  .vertical {
    font-size: 18px;
  }

  .didesnis div {
    font-size: 18px;
  }

  .didesnis div p,
  .didesnis div ol {
    font-weight: 400 !important;
  }

  @media (min-width: 768px) {
    .main-container {
      flex-direction: row;
      gap: 2rem;
    }
    .content-text img {
      width: 500px;
    }

    .contact-container {
      flex: 1;
      border-left: 1px solid #383d431f;
      padding-left: 2rem;
    }

    .text-container {
      flex: 3;
      margin-bottom: 3rem;
    }
  }
  @media (min-width: 1024px) {
    .main-container {
      padding: 0 10%;
      gap: 5rem;
    }
    .contact-container {
      padding-left: 5rem;
    }

    .vertical {
      display: flex;
      align-items: center;
    }
    .vertical img {
      max-width: 300px;
    }
    .didesnis {
      flex-direction: column;
    }
    .didesnis img {
      max-width: 440px;
    }
  }
  @media (min-width: 1230px) {
    .didesnis img {
      margin-top: 0;
      max-width: 330px;
    }

    .didesnis {
      gap: 1rem;
      flex-direction: row;
      align-items: flex-start;
    }

    .didesnis div {
      max-width: 440px;
    }
  }
</style>

<Base
  tabTitle={blog.title.rendered}
  title={blog.acf.seo_pavadinimas}
  description={blog.acf.seo_aprasas}
  image={blog.acf.pagrindine_nuotrauka}
  url={`https://www.dopaminas.lt/straipsniai/${blog.slug}`}
  date={blog.acf.isoDate}
  type="article"
>
  <div class="main-container">
    <div class="text-container">
      <div id="progress"></div>
      <div class="heading-row">
        <a href="/straipsniai" class="back-arrow" aria-label="Back to articles">
          <Image src={arrow_blue} alt="back arrow" loading="lazy" />
        </a>
        <a href="/straipsniai" class="clickable-title">
          <h1>{blog.title.rendered}</h1>
        </a>
      </div>
      <Autorius />
      <div class="content-text" set:html={blog.acf.kontentas} />
      <div>
        <div class="literatura" id="literatura-trigger">
          &lt;&lt; Literatūros sąrašas &gt;&gt;
        </div>

        <div class="overlay" id="literatura-overlay">
          <div class="overlay-content">
            <button class="close-btn" id="close-overlay">✕</button>
            <div set:html={blog.acf.literatura} />
          </div>
        </div>
      </div>
    </div>
    <div class="contact-container">
      <div class="contacts">
        <p class="sekite-mane">Sekite mane:</p>
        <div class="icon-container">
          <Image class="icon" src={ig} loading="lazy" alt="instagram" />
          <Image class="icon" src={fb} loading="lazy" alt="facebook" />
        </div>
      </div>
      <p class="sekite-mane">Naujausi straipsniai</p>
      <div class="popular">
        <ul>
          {
            five.map((blog) => (
              <li class="popular-blog">
                <a href={`/straipsnis/${blog.slug}`}>{blog.title.rendered}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <button
    class="back-to-top"
    onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
  >
    <img src={arrow.src} alt="Į viršų" />
  </button>
</Base>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const trigger = document.getElementById("literatura-trigger");
    const overlay = document.getElementById("literatura-overlay");
    const closeBtn = document.getElementById("close-overlay");

    trigger.addEventListener("click", () => {
      overlay.style.display = "flex";
      document.body.style.overflow = "hidden";
    });

    closeBtn.addEventListener("click", () => {
      overlay.style.display = "none";
      document.body.style.overflow = "";
    });

    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) {
        overlay.style.display = "none";
      }
    });
  });

  const progressBar = document.getElementById("progress");

  window.addEventListener("scroll", () => {
    const scrollTop = window.scrollY;
    const docHeight =
      document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = (scrollTop / docHeight) * 100;
    progressBar.style.width = scrollPercent + "%";
  });
</script>
