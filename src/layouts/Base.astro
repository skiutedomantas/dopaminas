---
import Logo from '../assets/logo.png';
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  tabTitle = 'Pagrindinis',
  title,
  description = "Dopaminas – Kineziterapija, judesio medicina ir sveikas gyvenimo būdas.",
  image,
  url = "https://www.dopaminas.lt",
  date = null,
  type = "website"
} = Astro.props;

const finalImage = image ?? Logo;
const GA_ID = "G-S9GHK1QX5M";
---

<html lang="lt">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/figura_juoda.webp" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/webp" href="/figura_balta.webp" media="(prefers-color-scheme: dark)" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <title>{`Dopaminas - ${tabTitle}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />

   <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
    <script>
      {`window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-S9GHK1QX5M');`}
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:title" content={`Dopaminas - ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={finalImage} />
    <meta property="og:url" content={url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`Dopaminas - ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalImage} />

    {type === "article" && date && (
      <script type="application/ld+json">
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "BlogPosting",
          "headline": title,
          "description": description,
          "image": finalImage,
          "author": {
            "@type": "Person",
            "name": "Dominykas Pakarklis"
          },
          "publisher": {
            "@type": "Organization",
            "name": "Dopaminas",
            "logo": {
              "@type": "ImageObject",
              "url": "https://www.dopaminas.lt/logo.png"
            }
          },
          "datePublished": date,
          "dateModified": date,
          "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": url
          }
        })}
      </script>
    )}

    {type === "page" && (
      <script type="application/ld+json">
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "WebPage",
          "name": title,
          "description": description,
          "url": url
        })}
      </script>
    )}

    <style>
      body {
        overflow-x: hidden;
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
